{
  "name": "agent-browser-core",
  "version": "0.1.0-a1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "measure": "node scripts/measure.mjs",
    "cli": "node src/cli.mjs",
    "engine:build": "node scripts/build-engine.mjs",
    "engine:verify": "node scripts/build-engine.mjs --verify-patch",
    "test:record": "node scripts/record-tests.mjs",
    "resources:build": "node scripts/build-resource-probe.mjs",
    "measure:resources": "npm run resources:build && node scripts/measure-resources.mjs",
    "pretest": "node scripts/build-resource-probe.mjs --if-supported"
  },
  "dependencies": {
    "puppeteer-core": "25.13.0"
  }
}
