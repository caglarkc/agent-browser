+test "cdp.Network: capture metadata and POST bytes stay bounded" {
+    var ctx = try testing.context();
+    defer ctx.deinit();
+    const bc = try ctx.loadBrowserContext(.{ .id = "BID-BOUNDS" });
+    const page = try bc.session.createPage();
+    bc.page_handle = page;
+    bc.target_id = id.toFrameId(page.frame_id);
+    try bc.networkEnable(.{ .total = 0, .resource = 0 });
+    const body: [4096]u8 = @splat('x');
+    for (0..300) |_| {
+        _ = try EchoDriver.run(bc, page.frame_id, &body, null);
+        try testing.expect(bc.captured_responses.count() <= max_capture_entries);
+        try testing.expect(bc.captured_requests.count() <= max_capture_entries);
+        try testing.expect(bc.captured_requests_size <= max_request_capture);
+        try testing.expectEqual(0, bc.captured_responses_size);
+    }
+    try testing.expectEqual(max_capture_entries, bc.captured_responses.count());
+    try testing.expectEqual(max_request_capture, bc.captured_requests_size);
+    try testing.expectEqual(max_request_capture, ctx.cdp().app.cdp_capture_bytes);
+    try bc.closeTarget();
+    try testing.expectEqual(0, ctx.cdp().app.cdp_capture_bytes);
+    try testing.expectEqual(0, bc.captured_responses.count());
+    try testing.expectEqual(0, bc.captured_requests.count());
+}
+
+test "cdp.Network: worker capture budget spans real sibling targets" {
+    var ctx = try testing.context();
+    defer ctx.deinit();
+    const root = try ctx.loadBrowserContext(.{ .id = "BID-WORKER" });
+    var targets: [12]*CDP.BrowserContext = undefined;
+    const body: [4096]u8 = @splat('w');
+    for (&targets, 0..) |*slot, index| {
+        const bc = if (index == 0) root else try ctx.cdp().allocatePageTarget();
+        slot.* = bc;
+        const page = try bc.session.createPage();
+        bc.page_handle = page;
+        bc.target_id = id.toFrameId(page.frame_id);
+        try bc.networkEnable(.{});
+        for (0..200) |_| {
+            _ = try EchoDriver.run(bc, page.frame_id, &body, null);
+            try testing.expect(ctx.cdp().app.cdp_capture_bytes <= @import("../../../App.zig").max_cdp_capture_bytes);
+        }
+    }
+    // The offered payload exceeds the shared budget, while all requests finish.
+    try testing.expect(ctx.cdp().app.cdp_capture_bytes > 7 * 1024 * 1024);
+    for (targets) |bc| bc.networkDisable();
+    try testing.expectEqual(0, ctx.cdp().app.cdp_capture_bytes);
+    // Capture remains usable after budget is returned.
+    try root.networkEnable(.{});
+    _ = try EchoDriver.run(root, root.page_handle.?.frame_id, "again", null);
+    try testing.expectEqual(5, root.captured_responses_size);
+    root.networkDisable();
+    try testing.expectEqual(0, ctx.cdp().app.cdp_capture_bytes);
+}
