    "dom": "5000 nodes/tab, 250 mutations/500ms, 64KiB fetch/15s",
    "cpu": "4 tabs each ~10ms synchronous compute/100ms timer; checksum and operation counter verified",
    "network": "10 tabs each 64KiB fetch/250ms, max 2 pending per tab; progress verified",
    "churn": "4 persistent active tabs plus batches of 5 new/navigate/close tabs every >=2s; native process retained",
    "soak": "4 profiles ×8 active tabs, 600s; reload/30s"
  },
  "guard": "Stop on sampled product physical footprint >2GiB, system pressure >=4, sampler errors, content/progress failure, worker death or leaks. No hard OS sandbox/cap."
